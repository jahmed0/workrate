# Normalise line endings in the repo to LF regardless of the OS committing.
# Without this, a Windows checkout commits CRLF and anyone cloning on macOS or
# Linux sees every file as fully modified.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
