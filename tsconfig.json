{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // priority.ts imports drift.ts with an explicit extension — Node's
    // native TS runner (tests/priority.verify.mts) requires that, but tsc
    // otherwise rejects it. Safe with noEmit: true, since Metro (not tsc)
    // does the actual bundling.
    "allowImportingTsExtensions": true
  },
  "exclude": [
    "node_modules",
    // Run directly by Node (which strips types), not bundled into the app.
    // Uses explicit .ts import extensions, which this config disallows.
    "tests",
    // Edge Functions run on Deno, not React Native — different globals and
    // URL imports. The Supabase CLI type-checks them with Deno at deploy time.
    "supabase"
  ]
}
